# ==========================================================================
# Temakinho — template variabili d'ambiente
#
# Questo file e' l'UNICO che viene versionato: contiene solo segnaposto.
# I valori reali si inseriscono nel pannello Dokploy (Environment), oppure
# in un file `.env` locale che resta fuori da Git.
#
# Per generare i salt WordPress:
#   curl -s https://api.wordpress.org/secret-key/1.1/salt/
# ==========================================================================

# --- Database: lato WordPress -------------------------------------------
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=temakinho
WORDPRESS_DB_USER=temakinho
WORDPRESS_DB_PASSWORD=CHANGE_ME
WORDPRESS_TABLE_PREFIX=wp_

# --- Database: lato MySQL (stessi valori di sopra) -----------------------
MYSQL_DATABASE=temakinho
MYSQL_USER=temakinho
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- URL del sito --------------------------------------------------------
# Staging in esempio. Per la produzione: https://www.temakinho.com
WORDPRESS_HOME=https://staging.temakinho.com
WORDPRESS_SITEURL=https://staging.temakinho.com

# --- Debug ---------------------------------------------------------------
# ATTENZIONE: l'immagine ufficiale WordPress considera vero QUALSIASI valore
# non vuoto, `0` compreso. Per disattivare il debug la variabile deve restare
# VUOTA. Mettere `1` solo in staging, mai in produzione.
WORDPRESS_DEBUG=

# --- Salt e chiavi WordPress --------------------------------------------
# Sostituire ognuno con una stringa unica e casuale.
WORDPRESS_AUTH_KEY=CHANGE_ME
WORDPRESS_SECURE_AUTH_KEY=CHANGE_ME
WORDPRESS_LOGGED_IN_KEY=CHANGE_ME
WORDPRESS_NONCE_KEY=CHANGE_ME
WORDPRESS_AUTH_SALT=CHANGE_ME
WORDPRESS_SECURE_AUTH_SALT=CHANGE_ME
WORDPRESS_LOGGED_IN_SALT=CHANGE_ME
WORDPRESS_NONCE_SALT=CHANGE_ME
